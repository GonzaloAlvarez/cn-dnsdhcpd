# cn-dnsdhcpd — copy to .env (gitignored). The real .env is Kauket-managed:
#   kauket get pki.cn_dnsdhcpd_env
# Comments must stay on their own lines (docker env files have no inline #).

# ── Technitium admin ────────────────────────────────────────────────────────
# First-boot admin password (also used by setup.sh to mint the API token).
# Mint with: openssl rand -base64 24
DNS_ADMIN_PASSWORD=
# Non-expiring API token, minted by setup.sh on first run (tokenName
# "automation") and written back here. Persist it into kauket afterwards —
# see README "Token round-trip". Used by seed-dns.sh and backup-dump.
TECHNITIUM_API_TOKEN=

# ── Resolver knobs (applied by seed-dns.sh — re-run it after changes) ───────
# recursion  = full recursion from the root servers (pfSense Unbound parity)
# forwarders = forward everything to DNS_FORWARDERS over DoH
DNS_UPSTREAM_MODE=recursion
# Comma-separated; only used when DNS_UPSTREAM_MODE=forwarders. Example:
# https://dns.quad9.net/dns-query (9.9.9.9),https://cloudflare-dns.com/dns-query (1.1.1.1)
DNS_FORWARDERS=
# DNSSEC validation. Launch value false = Unbound parity; flip after burn-in.
DNS_DNSSEC=false
# Built-in blocking (NOT the Advanced Blocking app). Launch value false.
# The Apple MDM sinkholes are independent Primary zones — unaffected by this.
DNS_BLOCKING=false
# Comma-separated block list URLs; only used when DNS_BLOCKING=true.
BLOCKLIST_URLS=

# ── pfSense DHCP → Technitium DDNS (RFC 2136) ───────────────────────────────
# TSIG key that authenticates pfSense's dynamic updates. seed-dns.sh installs
# the key into Technitium and applies update policies to the `lan` + reverse
# zones. The SAME name + secret go into every pfSense DHCP scope's
# "Dynamic DNS" section, algorithm hmac-sha256 (README runbook a).
# Mint the secret with: openssl rand -base64 32
DDNS_TSIG_KEY_NAME=pfsense-ddns
DDNS_TSIG_KEY_SECRET=

# ── Authentik SSO for the web console (applied by seed-dns.sh) ──────────────
# Provider bootstrap: cn-authentik/setup-dnsdhcpd-oidc.sh (run on neptune).
# Console callback is https://dns.pki.lan/sso/callback. Only Authentik
# `infra-admins` members may sign in; they land in Technitium's
# Administrators group via SSO_GROUP_MAP. Empty SSO_CLIENT_ID = leave SSO
# untouched. Local `admin` login always remains as break-glass.
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_AUTHORITY=https://auth.lab.gn.al/application/o/dnsdhcpd/
SSO_GROUP_MAP=infra-admins:Administrators

# ── Ops ─────────────────────────────────────────────────────────────────────
TIMEZONE=America/New_York

# ── SMTP — shared homelab Mailgun (same values as other cn-* stacks) ────────
SMTP_HOST=
SMTP_FROM=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_EMAIL=

# ── Backup — shared S3 + raidnas WebDAV ─────────────────────────────────────
BACKUP_S3_BUCKET=cloudnet-lab-storage
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=
BACKUP_AWS_REGION=us-east-2
BACKUP_WEBDAV_URL=http://raidnas.lan:5005
BACKUP_WEBDAV_USER=
BACKUP_WEBDAV_PASSWORD=
